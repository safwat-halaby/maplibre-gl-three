{
  "name": "maplibre-gl-three",
  "version": "0.0.8",
  "description": "Brings Three.js capabilities into MapLibre GL JS.",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "pack:dry-run": "npm pack --dry-run",
    "syncDeps": "node utils/sync_dependencies.js"
  },
  "license": "MIT",
  "homepage": "https://github.com/safwat-halaby/maplibre-gl-three",
  "bugs": {
    "url": "https://github.com/safwat-halaby/maplibre-gl-three/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safwat-halaby/maplibre-gl-three.git"
  },
  "keywords": [
    "maplibre",
    "three",
    "3d-tiles",
    "webgl"
  ],
  "author": "safwat-halaby",
  "type": "module",
  "module": "./dist/maplibre-gl-three.js",
  "main": "./dist/maplibre-gl-three.js",
  "types": "./dist/maplibre-gl-three.d.ts",
  "exports": {
    ".": {
      "types": "./dist/maplibre-gl-three.d.ts",
      "import": "./dist/maplibre-gl-three.js"
    },
    "./maplibre-gl-wrapper.js": {
      "types": "./dist/maplibre-gl-wrapper.d.ts",
      "import": "./dist/maplibre-gl-wrapper.js"
    },
    "./proj4-wrapper.js": {
      "types": "./dist/proj4-wrapper.d.ts",
      "import": "./dist/proj4-wrapper.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.ts.map",
    "README.md"
  ],
  "dependencies": {
    "proj4": "^2.15.0"
  },
  "peerDependencies": {
    "3d-tiles-renderer": "^0.4.21",
    "maplibre-gl": "^5.7.3",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "3d-tiles-renderer": "^0.4.21",
    "@types/three": "^0.183.0",
    "maplibre-gl": "^5.7.3",
    "proj4": "^2.20.9",
    "three": "^0.183.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  }
}
