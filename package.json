{
  "name": "maplibre-gl-three",
  "version": "1.0.2",
  "description": "Brings Three.js capabilities into MapLibre GL JS.",
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "test": "vitest run",
    "docs:api": "typedoc",
    "docs": "npm run docs:api && mkdocs build --strict",
    "pack:dry-run": "npm pack --dry-run",
    "syncDeps": "node utils/sync_dependencies.js"
  },
  "license": "MIT",
  "homepage": "https://maplibre-gl-three.readthedocs.io",
  "bugs": {
    "url": "https://github.com/safwat-halaby/maplibre-gl-three/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safwat-halaby/maplibre-gl-three.git"
  },
  "keywords": [
    "maplibre",
    "three",
    "3d-tiles",
    "webgl"
  ],
  "author": "safwat-halaby",
  "type": "module",
  "module": "./dist/maplibre-gl-three.js",
  "main": "./dist/maplibre-gl-three.js",
  "types": "./dist/maplibre-gl-three.d.ts",
  "exports": {
    ".": {
      "types": "./dist/maplibre-gl-three.d.ts",
      "import": "./dist/maplibre-gl-three.js"
    },
    "./proj4-wrapper.js": {
      "types": "./dist/type-wrappers/proj4-wrapper.d.ts",
      "import": "./dist/type-wrappers/proj4-wrapper.js"
    },
    "./geotiff-wrapper.js": {
      "types": "./dist/type-wrappers/geotiff-wrapper.d.ts",
      "import": "./dist/type-wrappers/geotiff-wrapper.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.js.map",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "README.md"
  ],
  "dependencies": {
    "geotiff": "^3.0.5",
    "proj4": "^2.22.0"
  },
  "peerDependencies": {
    "3d-tiles-renderer": "^0.5.3",
    "maplibre-gl": "^6.11.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "3d-tiles-renderer": "^0.5.3",
    "maplibre-gl": "^6.11.2",
    "three": "^0.186.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
